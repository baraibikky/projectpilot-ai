# ===================================================
# ProjectPilot AI — Environment Configuration
# ===================================================

# Server Port
PORT=5000

# AI Provider: 'auto', 'gemini', or 'mock'
AI_PROVIDER=auto

# Optional: Google Gemini API Key
# If omitted, ProjectPilot AI automatically runs with its intelligent,
# dynamic heuristic engine with zero errors or interruptions!
GEMINI_API_KEY=

# Gemini Model Identifier
AI_MODEL=gemini-1.5-flash
